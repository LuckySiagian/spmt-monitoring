DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=spmt_monitoring
DB_SSLMODE=disable

# development | production. In production the server refuses to start with an
# insecure default JWT_SECRET or an empty ALLOWED_ORIGINS.
APP_ENV=development

JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY_HOURS=24

SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
# Comma-separated list of browser origins allowed by CORS (required in production).
# Example: ALLOWED_ORIGINS=https://monitoring.pelindo.co.id,https://noc.pelindo.co.id
ALLOWED_ORIGINS=

# Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=SPMT Monitoring <your-email@gmail.com>

TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-global-chat-id

# Weekly email report schedule (server local time). 0=Sunday..1=Monday..6=Saturday
REPORT_WEEKDAY=1
REPORT_HOUR=8
GEMINI_API_KEY=your_gemini_api_key_here
DISABLE_CHROME_DIAGNOSTIC=false
CHROME_ON_DEMAND=false
SAVE_SCREENSHOT=true
 